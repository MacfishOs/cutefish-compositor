[Desktop Entry]
Type=Application
Name=Screenshot
Comment=Capture or record the screen, a window or a selected portion
Icon=accessories-screenshot
Exec=dbus-send --session --type=method_call --dest=com.cutefish.Screenshot /Screenshot com.cutefish.Screenshot.startCaptureMode
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=screenshot;screen recording;capture;record;
OnlyShowIn=Cutefish;
